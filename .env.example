# === WhatsApp Cloud API (dari Meta for Developers > WhatsApp > API Setup) ===
WA_TOKEN=isi_access_token_permanen
WA_PHONE_NUMBER_ID=isi_phone_number_id
WA_WABA_ID=isi_whatsapp_business_account_id
GRAPH_VERSION=v23.0

# === Webhook (untuk status terkirim/dibaca & opt-out "STOP") ===
WEBHOOK_VERIFY_TOKEN=buat_string_acak_sendiri
# App Secret dari Meta App > Settings > Basic (untuk verifikasi tanda tangan webhook)
APP_SECRET=

# === Dashboard ===
PORT=3000
# Password login dashboard. WAJIB diganti.
DASHBOARD_PASSWORD=ganti_password_ini
# Jeda antar pesan (milidetik) agar tidak terkena rate limit
SEND_DELAY_MS=1200
# true = tidak benar-benar mengirim (untuk uji coba)
DRY_RUN=false
